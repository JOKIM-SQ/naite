# Server-only Supabase connection. No NEXT_PUBLIC secret variables.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Cloud Inngest. Development uses a real local Inngest Dev Server.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Production callback origin; use the public canonical domain.
INNGEST_SERVE_ORIGIN=
# AI Gateway authentication: API key or fresh linked-project VERCEL_OIDC_TOKEN.
AI_GATEWAY_API_KEY=
VERCEL_OIDC_TOKEN=
# Optional model override. Default is documented in lib/ai.ts.
AI_MODEL=
# Optional direct Anthropic API connection instead of AI Gateway.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
