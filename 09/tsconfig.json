{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": false,
    "skipLibCheck": true
  },
  "include": ["public/*.mjs", "public/*.js", "public/*.d.ts", "scripts/*.mjs"],
  "exclude": ["node_modules", "public/vendor", "test"]
}
