{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "skipLibCheck": true
  },
  "include": ["api/**/*.mjs", "lib/**/*.mjs", "public/*.js", "public/*.mjs", "scripts/*.mjs"],
  "exclude": ["node_modules", "**/*.test.mjs"]
}
